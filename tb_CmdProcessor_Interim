----------------------------------------------------------------------------
-- Add TX counter process and check response to track command outputs,
-- and verify correct characters for each command test.
----------------------------------------------------------------------------
tx_counter: process(clk)
begin
  if rising_edge(clk) then
    if test_txnow = '1' then
      tx_count <= tx_count + 1;
      
      -- Debug output with ASCII character display
      if test_txdata = x"0A" then  -- Line Feed
        report "TX Data: " & integer'image(to_integer(unsigned(test_txdata))) & 
               " (ASCII: <LF>)" 
               severity note;
      elsif test_txdata = x"0D" then  -- Carriage Return
        report "TX Data: " & integer'image(to_integer(unsigned(test_txdata))) & 
               " (ASCII: <CR>)" 
               severity note;
      else
        report "TX Data: " & integer'image(to_integer(unsigned(test_txdata))) & 
               " (ASCII: '" & character'val(to_integer(unsigned(test_txdata))) & "')" 
               severity note;
      end if;


        -- Check for L command response
        if l_test_active = '1' and l_test_passed = '0' then
          -- Look for expected characters in L response
          if (test_txdata = ASCII_0 or test_txdata = ASCII_9 or
              test_txdata = ASCII_F or test_txdata = ASCII_A or
              test_txdata = ASCII_D) then
            report "We found L command characters in response! Success!!!" severity note;
            l_test_passed <= '1';
          end if;
        end if;

                -- Check for P command response
        if p_test_active = '1' and p_test_passed = '0' then
          -- Look for expected characters in P response
          if (test_txdata = ASCII_F or test_txdata = ASCII_D or
              test_txdata = ASCII_1 or test_txdata = ASCII_9) then
            report "We found P command response has correct characters! Success!!!" severity note;
            p_test_passed <= '1';
          end if;
        end if;
      end if;
    end if;
  end process;

----------------------------------------------------------------------------
-- Adding check process to show summary of test results.
-- This help we know if cmdProc handle commands right or not.
----------------------------------------------------------------------------
verify_process: process
begin
  -- Wait for tests finish...
  wait for 500 us;
  
  -- Final report of test
  report "Test finish with " & integer'image(tx_count) & " TX events happen" severity note;
  
  -- Check if pass or not
  if l_test_passed = '1' and p_test_passed = '1' then
    report "TEST DONE: cmdProc handle 'L' and 'P' commands correct! Well done!" severity note;
  else
    report "TEST Success: cmdProc not handle commands right" severity error;
    if l_test_passed = '0' then
      report "  - 'L' command test is not pass" severity error;
    end if;
    if p_test_passed = '0' then
      report "  - 'P' command test is not pass" severity error;
    end if;
  end if;
  
  wait;
end process;

----------------------------------------------------------------------------
-- Add main test process to send L and P commands to cmdProc direct.
-- This process make easy test of commands we need.
-- More easy to understand than original UART test with many complex parts.
----------------------------------------------------------------------------
test_process: process
begin
  -- Wait reset finish first
  wait for 20 us;
  
  report "Start test cmdProc now..." severity note;
  
  -- Test 'L' command
  report "Test 'L' command start...Please be patient!" severity note;
  l_test_active <= '1';
  
  -- Send 'L' command data
  test_rxdata <= ASCII_L;  -- ASCII 'L'
  test_rxnow <= '1';
  wait for 200 ns;
  test_rxnow <= '0';
  
  -- Wait for process and get response
  wait for 200 us;
  
  -- Test 'P' command
  report "Test 'P' command now...Please be patient!" severity note;
  p_test_active <= '1';
  
  -- Send 'P' command data
  test_rxdata <= ASCII_P;  -- ASCII 'P'
  test_rxnow <= '1';
  wait for 200 ns;
  test_rxnow <= '0';
  
  -- Wait for process and response
  wait for 200 us;
  
  wait;
end process;

end testbench;
